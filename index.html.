<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Digital Artistic Trade — Limited Digital Art</title>
<meta name="description" content="Digital Artistic Trade — limited-edition digital tiger artwork.">
<style>
:root{--bg:#07070b;--card:#11111a;--text:#f6f4ff;--muted:#aaa6bb;--line:#252331;--accent:#ff4fd8}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 20% 0%,#20102b 0,#07070b 34%),#07070b;color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif}
a{color:inherit;text-decoration:none}.wrap{max-width:1180px;margin:auto;padding:0 22px}
nav{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}
.logo{font-weight:800;letter-spacing:.08em;text-transform:uppercase}.logo span{color:var(--accent)}
.cart{border:1px solid #3a3547;padding:10px 15px;border-radius:999px;background:#0d0c13;color:var(--text);cursor:pointer}
.hero{padding:82px 0 62px;display:grid;grid-template-columns:1.1fr .9fr;gap:45px;align-items:center}
.kicker{color:#ff76dd;text-transform:uppercase;letter-spacing:.2em;font-size:12px;font-weight:700}
h1{font-size:clamp(48px,7vw,92px);line-height:.91;margin:14px 0 22px;letter-spacing:-.06em}
.hero p{font-size:18px;line-height:1.7;color:var(--muted);max-width:600px}
.btn{display:inline-block;margin-top:20px;padding:14px 20px;border-radius:12px;background:var(--text);color:#09080d;font-weight:800}
.hero-art{height:450px;border-radius:28px;overflow:hidden;border:1px solid #30283a;box-shadow:0 30px 90px #0008}
.hero-art img{width:100%;height:100%;object-fit:cover;display:block}
section{padding:72px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.section-head h2{font-size:38px;margin:0}.section-head p{color:var(--muted);margin:0}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{background:var(--card);border:1px solid var(--line);border-radius:20px;overflow:hidden}.art{aspect-ratio:1/1.02;background:#08080d}.art img{width:100%;height:100%;object-fit:cover;display:block}.info{padding:18px}.title{font-weight:800;font-size:18px}.meta{color:var(--muted);font-size:13px;margin:7px 0 15px}.row{display:flex;justify-content:space-between;align-items:center}.price{font-weight:800}.buy{border:0;border-radius:10px;padding:10px 13px;background:#fff;color:#09080d;font-weight:800;cursor:pointer}
.about{border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:50px}.about h2{font-size:38px}.about p{color:var(--muted);line-height:1.8}.edition{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stat{padding:20px;border:1px solid var(--line);border-radius:16px;background:#0d0c13}.stat b{font-size:28px;display:block}.stat span{color:var(--muted);font-size:13px}
footer{padding:35px 0;color:#858093;font-size:13px}
#toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(100px);background:#fff;color:#09080d;padding:13px 18px;border-radius:999px;font-weight:700;transition:.25s;z-index:10}#toast.show{transform:translateX(-50%) translateY(0)}
@media(max-width:800px){.hero,.about{grid-template-columns:1fr}.hero{padding-top:55px}.hero-art{height:330px}.grid{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.grid{grid-template-columns:1fr}.section-head{display:block}.section-head p{margin-top:8px}.edition{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="wrap">
<nav><div class="logo">Digital <span>Artistic</span> Trade</div><button class="cart" onclick="showCart()">Cart <span id="count">0</span></button></nav>

<header class="hero">
<div>
<div class="kicker">Limited digital editions</div>
<h1>Six tigers.<br>Six worlds.</h1>
<p>Original digital tiger portraits inspired by six different countries. Each artwork is presented as a limited edition of 100.</p>
<a class="btn" href="#shop">Explore the collection</a>
</div>
<div class="hero-art"><img src="data:image/jpeg;base64," alt="Tiger in a black suit and sunglasses"></div>
</header>

<section id="shop">
<div class="section-head"><h2>The Collection</h2><p>100 editions per artwork</p></div>
<div class="grid">
<article class="card"><div class="art"><img src="data:image/jpeg;base64," alt="USA Tiger — Liberty Stripe"></div><div class="info"><div class="title">USA Tiger — Liberty Stripe</div><div class="meta">United States • Edition 1–100</div><div class="row"><span class="price">€12</span><button class="buy" onclick="add('USA Tiger — Liberty Stripe')">Add</button></div></div></article>
<article class="card"><div class="art"><img src="data:image/jpeg;base64," alt="UK Tiger — Royal Guard"></div><div class="info"><div class="title">UK Tiger — Royal Guard</div><div class="meta">United Kingdom • Edition 1–100</div><div class="row"><span class="price">€12</span><button class="buy" onclick="add('UK Tiger — Royal Guard')">Add</button></div></div></article>
<article class="card"><div class="art"><img src="data:image/jpeg;base64," alt="Ireland Tiger — Emerald Roar"></div><div class="info"><div class="title">Ireland Tiger — Emerald Roar</div><div class="meta">Ireland • Edition 1–100</div><div class="row"><span class="price">€12</span><button class="buy" onclick="add('Ireland Tiger — Emerald Roar')">Add</button></div></div></article>
<article class="card"><div class="art"><img src="data:image/jpeg;base64," alt="UAE Tiger — Desert Gold"></div><div class="info"><div class="title">UAE Tiger — Desert Gold</div><div class="meta">United Arab Emirates • Edition 1–100</div><div class="row"><span class="price">€12</span><button class="buy" onclick="add('UAE Tiger — Desert Gold')">Add</button></div></div></article>
<article class="card"><div class="art"><img src="data:image/jpeg;base64," alt="China Tiger — Dragon Fortune"></div><div class="info"><div class="title">China Tiger — Dragon Fortune</div><div class="meta">China • Edition 1–100</div><div class="row"><span class="price">€12</span><button class="buy" onclick="add('China Tiger — Dragon Fortune')">Add</button></div></div></article>
<article class="card"><div class="art"><img src="data:image/jpeg;base64," alt="Russia Tiger — Winter Crown"></div><div class="info"><div class="title">Russia Tiger — Winter Crown</div><div class="meta">Russia • Edition 1–100</div><div class="row"><span class="price">€12</span><button class="buy" onclick="add('Russia Tiger — Winter Crown')">Add</button></div></div></article>
</div>
</section>

<section class="about">
<div><div class="kicker">About the shop</div><h2>Digital art without the ordinary.</h2></div>
<div><p>Digital Artistic Trade is a collection of original digital pieces. The first collection features six stylized tiger portraits, each released as a limited digital edition.</p>
<div class="edition"><div class="stat"><b>100</b><span>copies per artwork</span></div><div class="stat"><b>6</b><span>launch pieces</span></div><div class="stat"><b>600</b><span>total editions</span></div></div></div>
</section>

<footer>© 2026 Digital Artistic Trade · Limited digital artwork</footer>
</div>
<div id="toast"></div>
<script>
let cart=0;
function add(name){cart++;document.getElementById('count').textContent=cart;const t=document.getElementById('toast');t.textContent=name+' added to cart';t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1800)}
function showCart(){const t=document.getElementById('toast');t.textContent=cart?`You have ${cart} item${cart>1?'s':''} in your cart.`:'Your cart is empty.';t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200)}
</script>
</body>
</html>
